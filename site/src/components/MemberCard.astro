---
import type { TeamMember } from '../lib/team-meta';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const statsOrder: Array<['h' | 'a' | 'b' | 'c' | 'd' | 's', string]> = [
  ['h', 'HP'],
  ['a', 'こうげき'],
  ['b', 'ぼうぎょ'],
  ['c', 'とくこう'],
  ['d', 'とくぼう'],
  ['s', 'すばやさ'],
];
const typeKeyMap: Record<string, string> = {
  ノーマル: 'normal', ほのお: 'fire', みず: 'water', でんき: 'electric',
  くさ: 'grass', こおり: 'ice', かくとう: 'fighting', どく: 'poison',
  じめん: 'ground', ひこう: 'flying', エスパー: 'psychic', むし: 'bug',
  いわ: 'rock', ゴースト: 'ghost', ドラゴン: 'dragon', あく: 'dark',
  はがね: 'steel', フェアリー: 'fairy',
};
const typeKey = (t: string) => typeKeyMap[t] ?? 'normal';
const types = member.types ?? [];
const primaryKey = typeKey(types[0] ?? 'ノーマル');
const secondaryKey = typeKey(types[1] ?? types[0] ?? 'ノーマル');
const isDual = types.length >= 2 && types[0] !== types[1];
const typeCssVars = isDual
  ? `--type-primary: var(--type-${primaryKey}); --type-secondary: var(--type-${secondaryKey});`
  : `--type-primary: var(--type-${primaryKey});`;
---
<article
  class:list={['member-card', isDual ? 'dual-type' : 'single-type']}
  style={typeCssVars}
>
  <div class="member-inner">
    <header class="member-head">
      <div class="member-title">
        <h3 class="member-name">{member.name}</h3>
      </div>
    </header>

    <dl class="member-meta">
      {member.ability && <><dt>特性</dt><dd class="meta-strong">{member.ability}</dd></>}
      {member.item && <><dt>持ち物</dt><dd class="meta-strong">{member.item}</dd></>}
      {member.nature && <><dt>性格</dt><dd>{member.nature}</dd></>}
    </dl>

    {member.stat_points && (
      <section class="stats-section">
        <h4>SP</h4>
        <table class="stats-table">
          <thead>
            <tr>{statsOrder.map(([, label]) => <th>{label}</th>)}</tr>
          </thead>
          <tbody>
            <tr>{statsOrder.map(([key]) => <td>{member.stat_points?.[key] ?? '-'}</td>)}</tr>
          </tbody>
        </table>
      </section>
    )}

    {member.actual_stats && (
      <section class="stats-section">
        <h4>実数値</h4>
        <table class="stats-table">
          <thead>
            <tr>{statsOrder.map(([, label]) => <th>{label}</th>)}</tr>
          </thead>
          <tbody>
            <tr>{statsOrder.map(([key]) => <td>{member.actual_stats?.[key] ?? '-'}</td>)}</tr>
          </tbody>
        </table>
      </section>
    )}

    {member.moves.length > 0 && (
      <section class="moves-section">
        <h4>技</h4>
        <ul class="moves-list">
          {member.moves.map((m) => (
            <li style={`border-left-color: var(--type-${typeKey(m.type)})`}>
              <span class="move-name">{m.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</article>

<style>
  .member-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 1px;
    border-radius: 20px;
    corner-shape: superellipse(1.5);
  }
  .member-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.9);
    color: #fff;
    padding: 12px;
    border: solid 1px black;
    border-radius: 20px;
    corner-shape: superellipse(1.5);
  }
  :global(:root[data-theme="light"]) .member-inner {
    background: rgba(0, 0, 0, 0.7);
    border-color: transparent;
  }
  .member-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    z-index: -1;
  }
  :global(:root[data-theme="light"]) .member-card::before {
    opacity: 0.7;
  }
  /* `\` ライン (135deg = 左上→右下) で色を区切る。複合はくっきり四角構成、
     単タイプは下三角のみ色 + 上に向かって blur させる。 */
  .member-card.dual-type::before {
    background: linear-gradient(
      135deg,
      var(--type-primary) 0 48%,
      var(--type-secondary) 52% 100%
    );
  }
  .member-card.single-type::before {
    background: linear-gradient(
      135deg,
      transparent 0 40%,
      var(--type-primary) 80% 100%
    );
  }
  .member-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .member-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    width: 100%;
  }
  .member-name {
    margin: 0;
    font-size: 1.3rem;
  }
  .member-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: 0.9rem;
  }
  .member-meta dt {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
  }
  .member-meta dd { margin: 0; }
  .member-meta dd.meta-strong {
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  .stats-section h4, .moves-section h4 {
    margin: 0 0 0.35rem 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .stats-table {
    display: table;
    width: 100%;
    font-size: 0.85rem;
    margin: 0;
  }
  .stats-table th, .stats-table td {
    text-align: center;
    white-space: nowrap;
  }
  .moves-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.4rem;
  }
  .moves-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border-left: 2px solid transparent;
  }
  .move-name { flex: 1; }
  .move-meta { font-size: 0.75rem; white-space: nowrap; }
</style>
